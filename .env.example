# ==========================
# Lithe — Environment Variables
# ==========================
# Copy this file to `.env` and fill in your values.
# NEVER commit the `.env` file to version control.

# Your Google Gemini API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_api_key_here

# Comma-separated list of directories to index (F-03)
# Example: C:\Users\Name\Documents\DataScience,D:\Projects
INDEX_WHITELIST=
