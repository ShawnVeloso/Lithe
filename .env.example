# ==========================
# Lithe — Environment Variables
# ==========================
# Copy this file to `.env` and fill in your values.
# NEVER commit the `.env` file to version control.

# Your Google Gemini API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_api_key_here

# Comma-separated list of directories to index (F-03)
# Example: C:\Users\Name\Documents\DataScience,D:\Projects
INDEX_WHITELIST=

# ------------------------------------
# Ollama Fallback (Phase 2: Reliability)
# ------------------------------------
# When Gemini is unreachable, Lithe falls back to a local Ollama model.
# Install Ollama from https://ollama.com and pull a model (e.g., `ollama pull llama3`).

# Ollama server URL (default: http://localhost:11434)
# OLLAMA_URL=http://localhost:11434

# Ollama model name (default: llama3)
# OLLAMA_MODEL=llama3

# Timeout in seconds for Ollama requests (default: 60)
# OLLAMA_TIMEOUT=60

# ------------------------------------
# Token Budgeting
# ------------------------------------
# Soft limit for total token usage warning in the UI (default: 1500000)
# TOKEN_BUDGET_WARNING=1500000
