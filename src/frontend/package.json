{
  "name": "lithe-ui",
  "version": "1.0.0",
  "description": "Lithe — Desktop AI Assistant",
  "main": "./out/main/index.js",
  "author": "ShawnVeloso",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "postinstall": "electron-builder install-app-deps",
    "typecheck": "tsc --noEmit -p tsconfig.node.json --composite false && tsc --noEmit -p tsconfig.web.json --composite false",
    "build:win": "npm run build && electron-builder --win",
    "dist": "electron-vite build && electron-builder --win",
    "pack": "electron-vite build && electron-builder --win --dir"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.1",
    "@electron-toolkit/utils": "^3.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^36.9.5",
    "electron-builder": "^26.0.12",
    "electron-vite": "^3.1.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  },
  "build": {
    "appId": "com.lithe.app",
    "productName": "Lithe",
    "asar": true,
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/python-backend",
        "to": "python-backend",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "src/renderer/src/assets/icon.ico",
        "to": "icon.ico"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "src/renderer/src/assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Lithe",
      "deleteAppDataOnUninstall": false,
      "installerIcon": "src/renderer/src/assets/icon.ico",
      "uninstallerIcon": "src/renderer/src/assets/icon.ico",
      "installerHeaderIcon": "src/renderer/src/assets/icon.ico"
    }
  }
}
