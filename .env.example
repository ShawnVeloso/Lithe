# ==========================
# Lithe — Environment Variables
# ==========================
# Copy this file to `.env` and fill in your values.
# NEVER commit the `.env` file to version control.

# Your Google Gemini API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_api_key_here

# Comma-separated list of directories to index (F-03)
# Example: C:\Users\Name\Documents\DataScience,D:\Projects
INDEX_WHITELIST=

# ------------------------------------
# Ollama Fallback (Phase 2: Reliability)
# ------------------------------------
# When Gemini is unreachable, Lithe falls back to a local Ollama model.
# Install Ollama from https://ollama.com and pull a model that supports native
# tool calling (e.g., `ollama pull llama3.1` or `ollama pull mistral`).

# Ollama server URL (default: http://localhost:11434)
# OLLAMA_URL=http://localhost:11434

# Ollama model name (default: llama3.1). It must actually be pulled: Lithe
# checks the model is present before falling back, and if it is missing it says
# which models you do have rather than failing with a bare 404. Check with
# `ollama list`.
# OLLAMA_MODEL=llama3.1

# Timeout in seconds for Ollama requests (default: 60)
# OLLAMA_TIMEOUT=60

# ------------------------------------
# Testing
# ------------------------------------
# Set to 1 to enable the opt-in live capability evaluation:
#   LITHE_EVAL=1 python -m pytest -m eval
# LITHE_EVAL=0

# Which engine the evaluation scores: ollama (default) or gemini. Gemini's free
# tier allows 20 requests/day per model and one pass needs ~80-100, so a free
# key cannot complete a run. Ollama is local, free and repeatable. Scores are
# only comparable between runs of the same engine.
# LITHE_EVAL_ENGINE=ollama

# How many times each evaluation case runs (default 3). Model output varies,
# so a case passes on a majority and is reported flaky on a minority.
# LITHE_EVAL_REPEATS=3

# Base sampling seed for the Ollama evaluation; each repeat uses SEED + n.
# Pinning it is what makes two runs of the suite comparable -- unseeded, the
# same commit scored 86%, then 64%, then 86% on identical requests. Change it
# to resample the suite deliberately.
# LITHE_EVAL_SEED=20260905

# ------------------------------------
# Token Budgeting
# ------------------------------------
# Soft limit for total token usage warning in the UI (default: 1500000)
# TOKEN_BUDGET_WARNING=1500000

# How much of the conversation is re-sent on each request, in characters
# (default 48000, roughly 12k tokens). The transcript is kept whole in memory
# and on disk; this only bounds the window sent to the model, cut on a turn
# boundary so a tool exchange is never split.
# LITHE_MAX_HISTORY_CHARS=48000

# How much retrieved file content rides along with each request, in characters
# (default 60000). Files named in the conversation are cached so a follow-up
# question still sees them, with the oldest evicted first.
# LITHE_MAX_CONTEXT_CHARS=60000
