# ==========================
# Lithe — .gitignore
# ==========================

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
*.egg
.venv/
venv/
env/

# --- Environment & Secrets ---
.env
.env.local

# --- Node / Electron ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- Electron Build Artifacts ---
out/
release/
*.tsbuildinfo

# --- IDE ---
.vscode/
.idea/
*.swp
*.swo

# --- OS ---
Thumbs.db
Desktop.ini
.DS_Store

# --- SQLite ---
*.db
*.db-journal

# --- Lithe Specific ---
.lithe/
pyinstaller-build/
src/frontend/resources/python-backend/
*.spec

# --- github stops me from pushing the exe because it is above 100mb ---
*.exe
dist/
build/ 


# electron-builder's buildResources dir holds SOURCE (installer.nsh), not output.
# The blanket build/ rule above would silently drop it from version control.
!src/frontend/build/
!src/frontend/build/installer.nsh

# Pytest cache (regenerated on every run)
.pytest_cache/
